{
  "version": 1,
  "sdk_version": "0.24.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://qowzmltthmsiyhyklojz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "assignmate-mcp",
      "version": "0.1.0",
      "title": "Assignmate"
    },
    "tools": [
      {
        "name": "list_assignments",
        "title": "List assignments",
        "description": "List the signed-in student's Assignmate assignments, newest first. Optionally filter by a title search or status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "query": {
              "type": "string",
              "description": "Optional text to match against the assignment title."
            },
            "status": {
              "type": "string",
              "description": "Optional status filter, e.g. 'complete' or 'draft'."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "description": "How many assignments to return (default 10)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_assignment",
        "title": "Get assignment",
        "description": "Read one of the signed-in student's assignments in full, including the generated answer text in Markdown.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "The assignment id returned by list_assignments."
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_usage",
        "title": "Get plan and usage",
        "description": "Get the signed-in student's Assignmate plan, included features, monthly assignment usage and remaining quota.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      }
    ]
  }
}
